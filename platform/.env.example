# mago-platform — operator-private control plane (accounts + Stripe + webhook relay).
# Copy to platform/.env (gitignored) and fill the secrets. See docs/SAAS.md.

# Server
APP_URL=http://localhost:9100
PORT=9100
JWT_SECRET=change-me-long-random

# Stripe (test mode reuses AutoMaintainer's account — sk_test_ from ~/ai/automaintainer-saas-panel/.env)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# mago single plan — €20/month (created via API, test mode):
STRIPE_PRICE_MAGO=price_1TkrN64Gw2MGvAdPtEmGHB0o

# GitHub App / webhook relay: the secret configured on the GitHub App's webhook so the
# platform can verify X-Hub-Signature-256 before relaying events to workers.
GITHUB_WEBHOOK_SECRET=
# The GitHub App id. Setting it turns ON repo entitlement: a worker only receives events for
# repos its account has claimed via `mago link` (an installation). Leave empty for local/
# single-tenant dev, where the worker's self-declared repos are trusted.
GITHUB_APP_ID=

# Storage
DB_PATH=~/.mago-platform/platform.db

# Optional: encrypt sensitive columns at rest (AES-256-GCM)
SECRETS_KEY=
